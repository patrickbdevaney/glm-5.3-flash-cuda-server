# Build outputs and measurement logs are reproducible; keeping them out of the tree keeps a clone
# usable. They were tracked up to this commit, so history still carries them.
build/
logs/
*.o
__pycache__/
# Oracle fixtures: 741 MB, and regenerable from the checkpoint by ref/gen_*.py. They were stripped
# from history to get the repo under GitHub's 100 MB per-file limit; the generators are kept.
ref/*.bin
ref/**/*.bin
*.bak
